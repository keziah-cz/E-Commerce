
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Create account | SipVerse</title>

    <link rel="stylesheet" href="/css/style.css">
  </head>

  <body class="auth-page">

    <!-- Header -->
    <header class="topbar">
      <a class="brand" href="/login">
        <b class="mark">S</b>
        Sip<span>Verse</span>
      </a>

      <a href="/login">Back to sign in</a>
    </header>

    <!-- Registration form -->
    <main class="register-wrap">
      <section class="auth-card">

        <p class="eyebrow">JOIN THE SIPVERSE</p>

        <h2>Create your account</h2>

        <p class="muted">
          Register to browse and order your favorite drinks.
        </p>

        <!-- Display registration errors -->
        <% if (error) { %>
          <div class="notice">
            <%= error %>
          </div>
        <% } %>

        <!-- Account registration form -->
        <form method="POST" action="/register">

          <label for="name">Full name</label>
          <input
            type="text"
            id="name"
            name="name"
            value="<%= name %>"
            maxlength="100"
            required
          >

          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= email %>"
            required
            autocomplete="email"
          >

          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            minlength="8"
            required
            autocomplete="new-password"
          >

          <label for="confirmPassword">Confirm password</label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            minlength="8"
            required
            autocomplete="new-password"
          >

          <button class="btn primary full" type="submit">
            Create Account →
          </button>

        </form>

        <!-- Link to sign in -->
        <p class="center muted">
          Already registered?
          <a href="/login">Sign in</a>
        </p>

      </section>
    </main>

  </body>
</html>